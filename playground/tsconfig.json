{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "esnext"
    ],
    "module": "node18",
    "types": [
      "node"
    ],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "**/*.js",
    "**/*.mjs",
    "**/*.ts"
  ]
}
