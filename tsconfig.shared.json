{
  "compilerOptions": {
    "incremental": false,
    "target": "es2020",
    "lib": ["es2025"],
    "module": "node18",
    "rootDir": ".",
    "importHelpers": false,
    "preserveConstEnums": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "isolatedDeclarations": true,
    "removeComments": false,
    "sourceMap": false,
    "stripInternal": true,
    "paths": {
      "fast-check": ["./packages/fast-check/src/fast-check.ts"],
      "@fast-check/ava": ["./packages/ava/src/ava-fast-check.ts"],
      "@fast-check/jest": ["./packages/jest/src/jest-fast-check.ts"],
      "@fast-check/jest/worker": [
        "./packages/jest/src/jest-fast-check-worker.ts"
      ],
      "@fast-check/packaged": ["./packages/packaged/src/packaged.ts"],
      "@fast-check/poisoning": ["./packages/poisoning/src/main.ts"],
      "@fast-check/vitest": ["./packages/vitest/src/vitest-fast-check.ts"],
      "@fast-check/worker": ["./packages/worker/src/main.ts"]
    }
  }
}
