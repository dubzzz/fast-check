{
  "extends": ["config:recommended", ":dependencyDashboard"],
  "labels": ["dependencies"],
  "commitMessagePrefix": "⬆️ ",
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "matchFileNames": ["packages/*/package.json"],
      "matchDepTypes": ["dependencies", "peerDependencies", "optionalDependencies"],
      "rangeStrategy": "update-lockfile"
    },
    {
      "matchFileNames": ["packages/*/package.json"],
      "matchDepTypes": ["devDependencies"],
      "rangeStrategy": "bump"
    },
    {
      "matchFileNames": ["package.json", "examples/package.json", "website/package.json"],
      "rangeStrategy": "bump"
    },
    {
      "matchFileNames": ["package.json"],
      "matchDepTypes": ["pnpm.overrides"],
      "enabled": false
    },
    {
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "24 hours",
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "internalChecksFilter": "strict"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devEngines.runtime"],
      "matchPackageNames": ["node"],
      "enabled": false
    },
    {
      "description": "Automerge patch updates to development dependencies",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Automerge minor updates to development dependencies at version 1 or later",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": ">=1.0.0",
      "automerge": true
    },
    {
      "description": "Keep release tooling updates manual",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@changesets/cli", "pkg-pr-new"],
      "automerge": false
    },
    {
      "description": "Keep dependency override and resolution changes manual",
      "matchManagers": ["npm"],
      "matchDepTypes": ["overrides", "pnpm.overrides", "pnpm-workspace.overrides", "resolutions"],
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "postUpdateOptions": ["pnpmDedupe"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "ignorePaths": ["**/node_modules/**", "**/bower_components/**"],
  "configMigration": true
}
