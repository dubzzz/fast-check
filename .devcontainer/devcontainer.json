{
  "name": "fast-check",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:5-26-trixie",
  "remoteUser": "node",
  "customizations": {
    "vscode": {
      "extensions": ["-dbaeumer.vscode-eslint", "oxc.oxc-vscode", "GitHub.vscode-github-actions"],
      "settings": {
        "editor.formatOnSave": true
      }
    }
  },
  "postCreateCommand": "./.devcontainer/postCreateCommand.sh",
  "waitFor": "postCreateCommand"
}
