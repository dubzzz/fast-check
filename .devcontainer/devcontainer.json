{
  "name": "fast-check",
  "remoteEnv": {
    "PATH": "${containerEnv:HOME:/home/codespace}/.local/share/pnpm/bin:${containerEnv:HOME:/home/codespace}/.nvs:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": ["-dbaeumer.vscode-eslint", "oxc.oxc-vscode", "GitHub.vscode-github-actions"],
      "settings": {
        "editor.formatOnSave": true
      }
    }
  },
  "postCreateCommand": "./.devcontainer/postCreateCommand.sh",
  "waitFor": "postCreateCommand"
}
