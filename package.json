{
  "private": true,
  "name": "@fast-check/monorepo",
  "description": "Test making sure fast-check expose the right typings",
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    }
  },
  "workspaces": [
    ".github/actions/*",
    "examples",
    "packages/*",
    "website"
  ],
  "scripts": {
    "contributor:add": "all-contributors add",
    "build": "pnpm --filter {./packages/**} run build",
    "build-ci": "pnpm --filter {./packages/**} run build-ci",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "bench": "vitest bench",
    "bench:ci": "vitest bench --outputJson benchmark.json --compare benchmark.json",
    "bench:snap": "vitest bench --outputJson benchmark.json",
    "bench:compare": "vitest bench --compare benchmark.json",
    "typecheck": "pnpm --parallel run typecheck",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "publint": "pnpm --filter {./packages/**} --parallel exec publint --strict",
    "bump": "changeset",
    "changelog": "changeset status",
    "pack": "pnpm --filter {./packages/**} --parallel exec pnpm pack --out package.tgz",
    "unpack": "pnpm --filter {./packages/**} --parallel exec tar -xf package.tgz --strip-components=1 --exclude='package/package.json'",
    "update:documentation": "cross-env UPDATE_CODE_SNIPPETS=true pnpm run test --project fast-check test/documentation"
  },
  "devDependencies": {
    "@atproto/api": "^0.20.44",
    "@changesets/cli": "^3.0.3",
    "@fast-check/packaged": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "^4.0.18",
    "all-contributors-cli": "^6.26.1",
    "cross-env": "^10.1.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2002",
    "pkg-pr-new": "^0.0.88",
    "publint": "^0.3.24",
    "rolldown": "^1.2.9",
    "rolldown-plugin-dts": "^0.28.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
